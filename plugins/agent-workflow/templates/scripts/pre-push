#!/bin/bash
# Local git hook: refuse any push to main/master from this machine. Installed by /init-workflow via core.hooksPath.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main|refs/heads/master)
    echo "pre-push: direct push to ${remote_ref#refs/heads/} refused. Open a PR." >&2; exit 1;; esac
done
exit 0
